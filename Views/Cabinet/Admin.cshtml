@model ДЗ_на_25_мая_Тимур_Жуков.ViewModels.AdminCabinetViewModel
@{
    ViewData["Title"] = "Кабинет администратора";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2>Кабинет администратора</h2>
    <p class="text-muted">Список студентов и управление подтверждением почты</p>

    @if (Model?.Students == null || Model.Students.Count == 0)
    {
        <div class="alert alert-info mt-3">Студентов пока нет</div>
    }
    else
    {
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Фото</th>
                    <th>ФИО</th>
                    <th>Группа</th>
                    <th>Статус почты</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(student.PhotoUrl))
                            {
                                <img src="@student.PhotoUrl" alt="Фото" width="60" class="rounded" />
                            }
                            else
                            {
                                <span class="text-muted">Нет фото</span>
                            }
                        </td>
                        <td>@student.FullName</td>
                        <td>@student.GroupName</td>
                        <td>
                            @if (student.IsEmailConfirmed)
                            {
                                <span class="badge bg-success">✓ Почта подтверждена</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">⚠ Не подтверждена</span>
                            }
                        </td>
                        <td>
                            @if (!student.IsEmailConfirmed)
                            {
                                <form asp-action="ConfirmStudentEmail" asp-route-id="@student.AccountId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary btn-sm">Подтвердить почту</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <form asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">Выйти</button>
    </form>
</div>